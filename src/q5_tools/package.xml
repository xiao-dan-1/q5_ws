<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>q5_tools</name>
  <version>0.1.0</version>
  <description>Q5 机器人侧常驻工具节点。定位：要长期运行、由 launch 托管、跨机链路依赖的节点（和 q5_hand_bridge / q5_zmq_bridge 同类）。
    数采那套（bag2lerobot / preflight）在 q5_datacollect；一次性分析脚本继续放仓库 tools_robot/，都不进这里。</description>
  <maintainer email="xiaodan@example.com">xiaodan</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
